{
  "name": "@gxaditya/vamp-project",
  "version": "0.1.0",
  "type": "module",
  "description": "Filesystem-first Vamp project storage with atomic validated song writes, revision-safe granular edits, and project-root confinement.",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-file.mjs ../../THIRD_PARTY_NOTICES.md THIRD_PARTY_NOTICES.md"
  },
  "dependencies": {
    "@gxaditya/vamp-schema": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GxAditya/vamp.git",
    "directory": "packages/project"
  }
}
