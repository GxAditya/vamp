# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Python tool caches
__pycache__/
*.py[cod]

# Test output
coverage/

# Local Vamp projects: authored songs, provisioned assets, and rendered audio.
# Generated by the CLI, MCP server, and SDK at runtime; never package content.
vamp-projects/

# Local environment and logs
.env
.env.*
!.env.example
*.log

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local agent/editor configuration (may contain machine-specific paths)
.devin/mcp_config.local.json
.qoder/

# Native audio assets: provisioned per machine, never committed.
*.sf2
*.sfz

# npm publish artifacts
*.tgz

# Internal development tracking docs (requirements, task backlog, build log).
# Kept on disk for development context; not part of the public repo.
PRD.md
PROGRESS.md
TASKS_V1.md
